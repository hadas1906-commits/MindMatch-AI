{
  "ConnectionStrings": {
    "DefaultConnection": "Host=YOUR_HOST;Port=5432;Database=YOUR_DATABASE;Username=YOUR_USERNAME;Password=YOUR_PASSWORD;SSL Mode=Require;Trust Server Certificate=true"
  },

  "Security": {
    "PersonalDataProtectionPurpose": "MindMatchAI.Candidate.PersonalData.v1",
    "HashSecret": "CHANGE_THIS_TO_LONG_RANDOM_HASH_SECRET",
    "JwtSecret": "CHANGE_THIS_TO_LONG_RANDOM_JWT_SECRET_AT_LEAST_32_CHARS",
    "JwtIssuer": "MindMatchAI",
    "JwtAudience": "MindMatchAIUsers",
    "JwtExpirationHours": 8,
    "PasswordHashing": {
      "SaltSize": 16,
      "KeySize": 32,
      "Iterations": 100000,
      "StoredHashPartsCount": 3,
      "IterationsPartIndex": 0,
      "SaltPartIndex": 1,
      "HashPartIndex": 2
    }
  },

  "ModelServer": {
    "BaseUrl": "http://127.0.0.1:8001",
    "Endpoints": {
      "Relevance": "/relevance",
      "Diagnosis": "/diagnosis",
      "Routing": "/routing",
      "Diagnostic": "/diagnostic",
      "JobQuestionMatch": "/job-question-match",
      "TranscribeFile": "/transcribe-file",
      "Warmup": "/warmup",
      "Health": "/health"
    }
  },

  "PythonRunner": {
    "DefaultTimeoutMilliseconds": 60000,
    "PythonIoEncodingVariable": "PYTHONIOENCODING",
    "PythonIoEncodingValue": "utf-8",
    "PythonUtf8Variable": "PYTHONUTF8",
    "PythonUtf8Value": "1",
    "SuccessExitCode": 0,
    "ErrorExitCode": -1
  },

  "PythonPaths": {
    "PythonExe": "python",
    "RobertaScript": "../ml-service/services/relevance-check/predict.py",
    "ReasonsScript": "../ml-service/services/failure-reasons/diagnosis_model.py",
    "RoutingScript": "../ml-service/services/routing-classifier/predict.py",
    "BigFiveScript": "../ml-service/services/personality-traits/predict.py",
    "ExperienceScript": "../ml-service/services/experience/predict_experience.py",
    "PracticalAbilityScript": "../ml-service/services/practical-ability/evaluate_abilities.py",
    "ThinkingQualityScript": "../ml-service/services/thinking-quality/predict.py",
    "JobProfileExtractorScript": "../ml-service/services/job-question-matching/job_profile_extractor.py",
    "JobQuestionMatcherScript": "../ml-service/services/job-question-matching/predict_job_question_match.py",
    "AudioTranscriptionScript": "../ml-service/services/audio-transcription/transcribe_file.py"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*"
}